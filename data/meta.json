  "pickSteps": [
    "Stage 2: your first item slam picks the family. Bow or Guinsoo's means AD. Rod, tear or Jeweled Gauntlet means AP.",
    "Stage 3-2: check HP and streak. Healthy and winning means the fast 8 comp. Losing or under 60 HP means the reroll comp.",
    "Scout at 3-2 and 4-1: if two or more players are building your comp, switch to the other comp in your family."
  ],
  "rules": [
    {
      "title": "No rolling below 50 gold before 4-2",
      "detail": "Unless you're under 40 HP or playing a reroll comp at its roll timing."
    },
    {
      "title": "Under 50 HP at 4-1 on a fast 8 comp?",
      "detail": "Roll at 8 for a stable board, or switch to the reroll comp in your family. Don't greed for 9."
    },
    {
      "title": "Scout at 3-2 and 4-1",
      "detail": "If two or more players are building your carry, switch comps right away."
    },
    {
      "title": "Fight for 5th",
      "detail": "A 5th instead of an 8th saves you about 40 LP. When you're dying, roll everything for the strongest board you can make."
    },
    {
      "title": "Stop after two bottom-4s in a row",
      "detail": "Your –126 LP session on 14 Nov came from three bad games back to back."
    }
  ],
